<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>CultStore: Paid-social ad copywriting | Diya Nathwani</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f2eb;color:#18201a;font:17px/1.65 Arial,sans-serif}a{color:inherit;text-underline-offset:4px}header,main,footer{max-width:1160px;margin:auto;padding:28px 26px}header{display:flex;justify-content:space-between;border-bottom:1px solid #a7aba5;font-size:12px;letter-spacing:.06em}h1{font:clamp(48px,6.6vw,82px)/1.07 Georgia,serif;max-width:950px;letter-spacing:-.03em;margin:22px 0 28px}h2{font:clamp(32px,4.2vw,48px)/1.15 Georgia,serif;margin:12px 0 25px}h3{font-size:23px;line-height:1.3}.eyebrow{font-size:12px;letter-spacing:.15em;font-weight:bold}.lead{font-size:23px;line-height:1.5;max-width:840px}.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;border-top:1px solid #aaa;padding-top:24px;margin:38px 0}.meta small{display:block;color:#5e665e;font-size:11px;margin-bottom:9px}.meta b{font-size:15px;display:block}.hero-pair{display:grid;grid-template-columns:1fr 1fr;gap:18px;background:#182421;padding:24px}.hero-pair img{width:100%;height:420px;object-fit:contain}nav{display:flex;gap:20px;margin:28px 0;font-size:14px;flex-wrap:wrap}section{padding:65px 0;border-top:1px solid #a7aba5}.two{display:grid;grid-template-columns:1fr 1fr;gap:40px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;margin-top:32px}.box{padding:24px;background:#e9e9df;border-top:3px solid #40564b}.n{font:46px Georgia,serif;color:#65816d}.route{padding:30px;background:#182421;color:#fff}.route.alt{background:#e0e8de;color:#171917}.route h3{font:32px Georgia,serif}.refs{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.refs figure{margin:0}.refs img{width:100%;border:1px solid #aab1a7}.refs figcaption{padding:14px 0;font-size:14px}.refs b{display:block}.small{font-size:13px;color:#5d665e}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:16px}th,td{text-align:left;vertical-align:top;padding:20px 18px;border-bottom:1px solid #bcc3b7}th{font-size:12px;background:#e0e8de}td:last-child{font-weight:bold;color:#315945}.edit{display:grid;grid-template-columns:1fr 1fr;gap:30px;border-top:1px solid #bbc0b7;padding:22px 0}.edit small{font-weight:bold;font-size:11px}.edit p{margin:7px 0}.final{display:grid;grid-template-columns:minmax(0,550px) 1fr;gap:42px;align-items:start}.ig{background:white;border:1px solid #ccc;border-radius:14px;overflow:hidden;box-shadow:0 18px 40px #18242112;line-height:1.5;color:#171717}.ig-head{display:flex;align-items:center;gap:12px;padding:16px}.avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#171717;color:white;font-size:13px;font-weight:bold}.ig-head b{display:block;font-size:14px}.ig-head small{font-size:11px}.ig-head i{margin-left:auto;font-style:normal}.ig-img{position:relative;background:#eee}.ig-img img{display:block;width:100%;height:auto}.count{position:absolute;top:12px;right:12px;background:#000b;color:white;border-radius:20px;padding:5px 10px;font-size:12px}.shop{display:flex;justify-content:space-between;background:#e8f0ff;color:#2057a1;padding:13px 18px;font-size:14px;font-weight:bold;border:0;width:100%;text-align:left;cursor:default}.icons{font-size:26px;padding:10px 18px 0;letter-spacing:8px}.ig-caption{padding:13px 18px 20px;font-size:14px}.ig-caption b{margin-right:8px}.nav-slide{display:flex;justify-content:space-between;align-items:center;margin:15px 0;gap:10px}.nav-slide button,.pdf{padding:10px 17px;border:1px solid;background:#182421;color:white;font-weight:bold;font-size:13px;border-radius:6px;cursor:pointer}.nav-slide button:disabled{opacity:.35;cursor:default}.pdf{display:inline-block;text-decoration:none;background:transparent;color:#182421}.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.thumbs button{border:2px solid transparent;padding:0;background:transparent;cursor:pointer}.thumbs button[aria-current=true]{border-color:#345d46}.thumbs img{width:100%;display:block}.thumbs span{font-size:11px}.notice{background:#e9e9df;padding:18px 22px;border-left:3px solid #40564b;font-size:14px;margin:26px 0}@media(max-width:720px){header,main,footer{padding:22px 18px}header span{display:none}.lead{font-size:20px}.meta{grid-template-columns:1fr 1fr;gap:22px}.hero-pair{padding:12px;gap:10px}.hero-pair img{height:auto}.two,.three,.final{grid-template-columns:1fr;gap:22px}.refs{grid-template-columns:1fr 1fr}.refs figure:first-child{grid-column:1/-1}.edit{grid-template-columns:1fr;gap:10px}section{padding:42px 0}.route{padding:25px}td,th{padding:15px 12px;min-width:170px}.ig{border-radius:10px}}
header{align-items:center}.platforms{display:flex;gap:12px;align-items:center}.platforms>span:last-child{font-size:10px}.instagram{width:24px;height:24px;border:2px solid;border-radius:7px;position:relative}.instagram i{position:absolute;border:2px solid;width:11px;height:11px;border-radius:50%;top:5px;left:5px}.instagram:after{content:'';position:absolute;right:3px;top:3px;background:currentColor;width:3px;height:3px;border-radius:50%}.facebook{display:grid;place-items:center;background:#18201a;color:#f5f2eb;border-radius:50%;width:25px;height:25px;font:25px Arial}.role-line{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;font-size:10px;padding:24px 0}.role-line b{display:block;font-size:14px;margin-top:8px}.hero-pair img{height:390px}.brief-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.brief-grid article{border-top:3px solid #345644;padding:18px;background:#e9e9df}.symbol{font:40px Georgia,serif;color:#56735c}.brief-grid h3{font-size:19px}.brief-grid ul{padding-left:17px;font-size:14px}.brief-grid li{margin:8px 0}.refs figcaption{font-size:15px}.refs h3{font:23px/1.3 Georgia,serif}.refs small,.early-flow small,.decision-stack small,.options-grid small,.edit-head small{font-size:10px;letter-spacing:.06em}.boundary{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:20px;padding:22px;background:#182421;color:white;font-size:14px;margin-top:28px}.early-flow{display:grid;grid-template-columns:1.2fr 50px 1fr;gap:25px;padding:24px;background:#e0e8de}.early-flow b{display:block;margin-top:9px}.early-flow p{font-size:14px;margin-bottom:0}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.chips span{padding:7px 12px;border:1px solid #65816d;border-radius:18px;font-size:13px}.flow-arrow{display:grid;place-items:center;font-size:35px}.options-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:25px;margin-top:35px}.options-grid article{display:grid;grid-template-columns:160px 1fr;border:1px solid #c1c7bd;background:#fffdf8}.options-grid img{width:160px;height:100%;max-height:440px;object-fit:contain;background:#e9e9df}.options-grid article>div{padding:22px}.options-grid h3{margin:14px 0 7px;font:27px Georgia,serif}.options-grid p{font-size:14px;line-height:1.6}.status{font-size:9px;padding:5px 7px;background:#345644;color:white;display:inline-block;font-weight:bold}.status.muted{background:#e3e4db;color:#3c463e}.question{font-size:18px!important;font-weight:bold}.mini-flow{display:flex;flex-wrap:wrap;align-items:center;gap:7px;font-size:10px}.mini-flow span{padding:7px 9px;background:#e0e8de}.mini-flow i{font-style:normal}.decision-diagram{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.tri-wrap svg{width:100%;overflow:visible;font:12px Arial}.svg-big{font-size:20px;font-weight:bold}.decision-stack article{border-top:1px solid #afb8aa;padding:18px 0}.decision-stack h3{margin:8px 0}.decision-stack p{font-size:15px;margin:8px 0}.reason{color:#45624b}.copy-equation{display:grid;grid-template-columns:1fr 35px 1fr 35px 1fr;align-items:center;gap:20px;margin-top:28px;padding:27px;background:#182421;color:#fff}.copy-equation small{font-size:10px}.copy-equation h3{font-size:20px}.copy-equation>span{font-size:30px}.edit-case{margin-top:40px;border-top:1px solid #aaa;padding:25px 0}.edit-head{display:flex;gap:18px;align-items:center;margin-bottom:25px}.edit-head>span{font:48px Georgia,serif;color:#65816d}.edit-head h3{margin:5px 0;font:29px Georgia,serif}.before-after{display:grid;grid-template-columns:1fr 35px 1fr 1.5fr;gap:17px;align-items:start}.before-after figure{margin:0}.before-after img{width:100%;display:block}.before-after figcaption{font-size:9px;font-weight:bold;margin-top:12px}.edit-arrow{font-size:30px;align-self:center;text-align:center}.edit-reason p{font-size:14px;line-height:1.65;margin-top:0}.edit-reason .small{font-size:12px}.copy-steps{font-size:13px;display:flex;flex-direction:column;gap:8px;background:#e0e8de;padding:15px;margin:15px 0}.copy-steps i{font-size:10px;color:#556653;font-style:normal}.micro-edits{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.micro-edits article{padding:20px;background:#e9e9df}.micro-edits img{width:100%;max-height:280px;object-fit:contain}.micro-edits p{font-size:14px}.micro-edits small{font-size:9px;font-weight:bold}.change{display:flex;flex-direction:column;gap:6px;margin:15px 0;font-size:16px}.highlight{background:#f9e699}.evidence-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.evidence-grid article{background:#e0e8de;padding:27px}.evidence-grid p{font-size:15px}.evidence-grid small,.projection small{font-size:10px}.evidence-grid h3{font:32px Georgia,serif}.evidence-grid a{font-size:13px}.projection{padding:28px;background:#182421;color:white;margin:28px 0}.projection h3{font:27px Georgia,serif}.math{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid #769080;border-bottom:1px solid #769080;padding:25px 0}.math span{font-size:11px}.math b{display:block;font:43px Georgia,serif;margin-bottom:8px}.math i{font:28px Georgia,serif}.projection>p{font-size:15px}.projection .small{color:#c3cfc2}.sensitivity{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;font-size:12px}.sensitivity b{display:block;font-size:20px}.measure-two{display:grid;grid-template-columns:repeat(2,1fr);gap:40px}.measure-two ul{font-size:15px;padding-left:20px}.test-row{padding:15px 0;border-top:1px solid #acb6a5}.test-row b,.test-row span,.test-row small{display:block}.test-row span{font-size:15px}.test-row small{font-size:12px;color:#576451}footer{display:flex;justify-content:space-between;font-size:12px}h1{margin-top:18px}.final .small{font-size:12px}.final .notice{font-size:13px}nav{font-size:12px;gap:15px}
@media(max-width:900px){.brief-grid{grid-template-columns:1fr 1fr}.options-grid article{grid-template-columns:130px 1fr}.options-grid img{width:130px}.before-after{grid-template-columns:1fr 25px 1fr}.edit-reason{grid-column:1/-1}.boundary{grid-template-columns:1fr 1fr}}
@media(max-width:720px){.platforms>span:last-child{display:none}.platforms{gap:10px}.role-line{grid-template-columns:1fr;font-size:9px}.role-line b{font-size:14px;margin-top:3px}.hero-pair img{height:auto}.brief-grid{gap:12px}.brief-grid article{padding:14px}.brief-grid h3{font-size:17px}.brief-grid ul{font-size:12px;padding-left:13px}.symbol{font-size:30px}.options-grid{grid-template-columns:1fr}.options-grid article{grid-template-columns:110px 1fr}.options-grid img{width:110px}.options-grid article>div{padding:15px}.options-grid h3{font-size:24px}.options-grid p{font-size:13px}.status{font-size:8px}.decision-diagram,.early-flow,.evidence-grid,.measure-two{grid-template-columns:1fr;gap:20px}.flow-arrow{transform:rotate(90deg);height:35px}.copy-equation{grid-template-columns:1fr;gap:3px;padding:24px}.copy-equation>span{transform:rotate(90deg);text-align:center;font-size:22px;height:25px}.copy-equation h3{margin:7px 0}.before-after{grid-template-columns:1fr 24px 1fr;gap:10px}.edit-head h3{font-size:25px}.micro-edits{grid-template-columns:1fr}.micro-edits article{display:grid;grid-template-columns:1fr 110px;gap:10px}.micro-edits small,.micro-edits .change,.micro-edits p{grid-column:1}.micro-edits img{grid-column:2;grid-row:1/4;align-self:center}.projection{padding:22px}.math b{font-size:31px}.math span{font-size:10px}.math i{font-size:20px}.projection h3{font-size:24px}.sensitivity{gap:10px;font-size:10px}.sensitivity b{font-size:16px}.refs{grid-template-columns:1fr}.refs figure:first-child{grid-column:auto}.boundary{grid-template-columns:1fr}.early-flow small{display:block;margin-bottom:10px}footer span{display:none}}

@media(max-width:720px){header .platforms .instagram{display:block;flex-shrink:0}header .platforms .facebook{display:grid;flex-shrink:0}header .platforms{flex-shrink:0}}
</style></head><body><header><a href="/#work">DIYA NATHWANI / SELECTED WORK</a><div class="platforms"><span class="instagram" aria-label="Instagram"><i></i></span><b class="facebook" aria-label="Facebook">f</b><span>INSTAGRAM + FACEBOOK</span></div></header>
<main><div class="hero"><p class="eyebrow">CULTSTORE / COPYWRITING ASSIGNMENT</p><h1>Paid-social<br>ad copywriting.</h1><p class="lead">One pull-up bar. Two buying questions.<br><strong>What can I do with it? Can I trust it?</strong></p><div class="hero-pair"><img data-art="c1-01" alt="Final product-use carousel cover"><img data-art="c2-01" alt="Final testimonial carousel cover"></div><div class="role-line"><span>MY ROLE<br><b>Strategy · Copy · Imagery direction</b></span><span>BRAND ROLE<br><b>Final design · Media running</b></span><span>RESULTS<br><b>Creative delivered. No campaign data.</b></span></div></div>
<nav><a href="#brief">01 Brief</a><a href="#research">02 Research</a><a href="#options">03 Options</a><a href="#decisions">04 Decisions</a><a href="#edits">05 Edits</a><a href="#final">06 Final ads</a><a href="#measurement">07 Measurement</a></nav>
<section id="brief"><p class="eyebrow">01 / THE BRIEF</p><h2>Make the purchase useful.<br>Then make it credible.</h2><div class="brief-grid"><article><span class="symbol">◎</span><h3>Target group</h3><ul><li>Adults aged 25-35.</li><li>Working, earning consumers.</li><li>Active lifestyle. Beginners included.</li><li>Not children.</li></ul></article><article><span class="symbol">Aa</span><h3>Brand voice</h3><ul><li>Short. Punchy. Playful.</li><li>A challenge, not a lecture.</li><li>Benefits before specifications.</li><li>Movement before motivation clichés.</li></ul></article><article><span class="symbol">≠</span><h3>Constraints</h3><ul><li>Keep the bar the hero.</li><li>Make uses clear, not exhaustive.</li><li>No invented counts or ratings.</li><li>No cure or transformation promises.</li></ul></article><article><span class="symbol">▤</span><h3>Work shown</h3><ul><li>Two paid-social carousel routes.</li><li>Client set: 7 cards per route.</li><li>Portfolio: 8, with a shopping close.</li><li>Captions below are presentation drafts.</li></ul></article></div><p class="small">The wider equipment assignment changed over time. This case study covers these two pull-up-bar sets, not every deliverable in the original brief.</p></section>
<section id="research"><p class="eyebrow">02 / THE REFERENCE STUDY</p><h2>Borrow the writing pattern.<br>Not the promise.</h2><div class="refs"><figure><img data-art="ref143" alt="CultStore pull-up-bar reference ad"><figcaption><small>OUTCOME FIRST</small><h3>"Your next PR starts at your doorway."</h3><p><b>Observation:</b> The destination comes before the hardware.</p><p><b>Application:</b> Show what the reader can train. Let position labels explain how.</p><a href="https://www.facebook.com/ads/library/?id=1434337641975628" target="_blank" rel="noopener">Source ad ↗</a></figcaption></figure><figure><img data-art="ref153" alt="CultStore adjustable-kettlebell reference ad"><figcaption><small>VALUE THROUGH RANGE</small><h3>"Why buy 6 kettlebells when 1 does it all?"</h3><p><b>Observation:</b> A comparison turns versatility into value.</p><p><b>Application:</b> Make one bar's range visible. Do not force a numerical exercise claim.</p><a href="https://www.facebook.com/ads/library/?id=1534676441592112" target="_blank" rel="noopener">Source ad ↗</a></figcaption></figure><figure><img data-art="ref244" alt="CultStore home-cardio reference ad"><figcaption><small>FEATURE → EVERYDAY BENEFIT</small><h3>"Folds away, stays ready."</h3><p><b>Observation:</b> Two linked clauses turn storage into convenience.</p><p><b>Application:</b> "Lower the bar. Not the effort." The scene makes the wordplay concrete.</p><a href="https://www.facebook.com/ads/library/?id=2445594609191704" target="_blank" rel="noopener">Source ad ↗</a></figcaption></figure></div><div class="boundary"><b>What did not carry across</b><span>Massage-chair relaxation ≠ strength-training promise.</span><span>Another product's rating ≠ this bar's proof.</span><span>Visible ad ≠ proven winner.</span></div><p class="small">Also studied: <a href="https://www.facebook.com/ads/library/?id=991492920198841">4-in-1 home gym</a> and <a href="https://www.facebook.com/ads/library/?id=1393699175733489">massage chairs</a>. The supplied library was sorted by impressions. That did not expose impression counts, clicks or sales for these reference ads.</p></section>
<section id="options"><p class="eyebrow">03 / EXPLORATION</p><h2>Different hooks are not<br>always different ideas.</h2><div class="early-flow"><div><small>FIVE EARLY ROUTES</small><div class="chips"><span>Space</span><span>More than pull-ups</span><span>No commute</span><span>No DIY setup</span><span>A familiar doorway</span></div></div><span class="flow-arrow">→</span><div><small>FIRST CONSOLIDATION</small><b>More Than Pull-Ups</b><b>Strength Fits Here</b><p>Space, commute, setup and doorway became one fit-into-life story. A fresh sequence, not four hooks stacked together.</p></div></div><p class="small">The work later developed into four sets below. These were developed drafts, not tested ads. The decision lenses describe the thinking, not frameworks named in the original brief.</p>
<div class="options-grid"><article><img data-art="c1-01" alt="Selected exercise-library cover"><div><span class="status">SELECTED / C1</span><h3>Exercise library</h3><p class="question">"What can I do with it?"</p><div class="mini-flow"><span>Position</span><i>→</i><span>Move</span><i>→</i><span>Benefit</span></div><p><b>Lens:</b> Expand perceived usefulness.</p><p><b>Why keep it:</b> The scenes answer a purchase question. Variety has visual proof.</p></div></article><article><img data-art="goals" alt="Revised strength-goals focus-selector draft"><div><span class="status muted">EXPLORED / NOT SUBMITTED</span><h3>Strength goals</h3><small>SHOWN: REVISED FOCUS-SELECTOR DRAFT</small><p class="question">"What do I want to train?"</p><div class="mini-flow"><span>Goal</span><i>→</i><span>Move</span><i>→</i><span>Focus</span></div><p><b>Lens:</b> Let the reader self-select.</p><p><b>Why not the final pair:</b> The first version repeated the library's exercises. A new hook did not create a new job. Reworked as a focus selector.</p></div></article><article><img data-art="c2-01" alt="Selected customer-review cover"><div><span class="status">SELECTED / C2</span><h3>Customer evidence</h3><p class="question">"Can I trust it?"</p><div class="mini-flow"><span>Concern</span><i>→</i><span>Quote</span><i>→</i><span>Trust</span></div><p><b>Lens:</b> Social proof, without invented outcomes.</p><p><b>Why keep it:</b> Installation, grip and stability answer objections the library cannot.</p></div></article><article><img data-art="education" alt="Explored pull-up education chapter cover"><div><span class="status muted">EXPLORED / NOT SUBMITTED</span><h3>Pull-up education</h3><p class="question">"Why is the move demanding?"</p><div class="mini-flow"><span>Question</span><i>→</i><span>Science</span><i>→</i><span>Action</span></div><p><b>Lens:</b> Explain effort through bodyweight and muscle roles.</p><p><b>Decision:</b> Developed, not submitted. No documented rejection reason. No performance judgement.</p></div></article></div></section>
<section id="decisions"><p class="eyebrow">04 / THE SELECTION LOGIC</p><h2>One route adds value.<br>The other removes doubt.</h2><div class="decision-diagram"><div class="tri-wrap"><svg viewBox="0 0 500 340" role="img" aria-label="Decision triangle: usefulness, credibility and action"><path d="M250 40 L455 280 L45 280 Z" fill="#e2e9de" stroke="#345644" stroke-width="2"/><circle cx="250" cy="40" r="9" fill="#345644"/><circle cx="455" cy="280" r="9" fill="#345644"/><circle cx="45" cy="280" r="9" fill="#345644"/><text x="250" y="20" text-anchor="middle">USEFULNESS</text><text x="60" y="315" text-anchor="start">CREDIBILITY</text><text x="440" y="315" text-anchor="end">ACTION</text><text x="250" y="190" text-anchor="middle" class="svg-big">ONE PRODUCT</text><text x="250" y="220" text-anchor="middle">TWO DIFFERENT JOBS</text></svg></div><div class="decision-stack"><article><small>C1 / REFRAME THE PURCHASE</small><h3>Bar → workout range</h3><p>Mounting positions are not the benefit. The exercises they enable are.</p><p class="reason">So: position strip + exercise scene + named move. Not a spec list.</p></article><article><small>C2 / MAKE THE CLAIM ACCOUNTABLE</small><h3>Brand says → customer says</h3><p>A quote grounds the headline in one person's experience.</p><p class="reason">So: keep names and useful detail. Do not turn one review into a guarantee.</p></article><article><small>THE PAIR / AVOID DUPLICATION</small><h3>Range + reassurance</h3><p>Two exercise catalogues repeat value. Reviews add a missing reason to buy.</p><p class="reason">This was a creative decision. No analytics drove the selection.</p></article></div></div>
<div class="copy-equation"><div><small>FEATURE</small><h3>Top / middle / low mount</h3></div><span>→</span><div><small>READER BENEFIT</small><h3>More ways to train</h3></div><span>→</span><div><small>FINAL LINE</small><h3>"Lower the bar.<br>Not the effort."</h3></div></div></section>
<section id="edits"><p class="eyebrow">05 / THE MODIFICATIONS</p><h2>The strongest changes<br>removed competing jobs.</h2><div class="edit-case"><div class="edit-head"><span>01</span><div><small>C1 / COVER</small><h3>One objection. One range promise.</h3></div></div><div class="before-after"><figure><img data-art="oldc1" alt="Earlier C1 cover: two questions and 22 exercises"><figcaption>BEFORE / EXPLORATION</figcaption></figure><div class="edit-arrow">→</div><figure><img data-art="c1-01" alt="Final C1 cover: one question and Endless exercises"><figcaption>AFTER / APPROVED PORTFOLIO</figcaption></figure><div class="edit-reason"><p><del>No time for gym?</del></p><p><b>Keep:</b> "No room for a home gym?"</p><p>Time and space compete for the opener. Space leads directly into one compact bar's range.</p><p>"22 exercises" became "Endless exercises". The shorter selected set no longer centres an exact count.</p><p class="small">The collage stayed. A text-only cover was a misread, not the chosen direction.</p></div></div></div>
<div class="edit-case"><div class="edit-head"><span>02</span><div><small>C2 / TRUST HOOK</small><h3>Own the evidence. Lose the borrowed logos.</h3></div></div><div class="before-after"><figure><img data-art="oldc2" alt="Earlier C2 cover with festival offer and marketplace ratings"><figcaption>BEFORE / EXPLORATION</figcaption></figure><div class="edit-arrow">→</div><figure><img data-art="c2-01" alt="Final C2 own-brand review cover"><figcaption>AFTER / APPROVED PORTFOLIO</figcaption></figure><div class="edit-reason"><p><b>Before:</b> "Big claims? We'd rather show receipts." + a buying question + marketplace ratings + an offer.</p><p><b>After:</b> "The reviews are IN. / We have set the bar HIGH."</p><p>The first cover asked the reader to process four messages. The final cover points to one proof source: CultStore customer experience.</p><p>Festival and marketplace elements left the hook. The supplied portfolio CTA kept its festival offer.</p><p class="small">Removal was not universal. The supplied warning-triangle asset also retained a faint stock watermark.</p></div></div></div>
<div class="edit-case"><div class="edit-head"><span>03</span><div><small>C2 / INSTALLATION</small><h3>Keep the benefit. Tighten the challenge.</h3></div></div><div class="before-after"><figure><img data-art="olddrill" alt="Earlier installation testimonial card"><figcaption>BEFORE / ACTUAL CARD</figcaption></figure><div class="edit-arrow">→</div><figure><img data-art="c2-04" alt="Final No drilling required No excuses allowed card"><figcaption>AFTER / APPROVED PORTFOLIO</figcaption></figure><div class="edit-reason"><p><b>Before:</b> "No drilling required, / so you better find a diff excuse!"</p><div class="copy-steps"><span>"No drilling. No excuses."</span><i>↓ too short</i><span>"No drilling required. No excuses."</span><i>↓ final choice</i><b>"No drilling required.<br>No excuses allowed."</b></div><p>"Required" preserves the practical benefit. "Allowed" makes the challenge firmer. The quote supplies the installation experience.</p><p class="small">The final wording was Diya's explicit pick, not a performance winner.</p></div></div></div>
<div class="edit-case"><div class="edit-head"><span>04</span><div><small>PORTFOLIO ONLY / CTA</small><h3>The line already shows the contrast.</h3></div></div><div class="before-after"><figure><img data-art="arrows" alt="Explored portfolio CTA with up and down arrows"><figcaption>BEFORE / ARROWS TRIAL</figcaption></figure><div class="edit-arrow">→</div><figure><img data-art="c2-08" alt="Final portfolio CTA without arrows"><figcaption>AFTER / APPROVED</figcaption></figure><div class="edit-reason"><p><b>Supplied original:</b> "Pull yourself up. Bring the price down."</p><p><b>Diya's replacement:</b> "Your turn to raise the bar, / While the prices are down."</p><p>Up/down arrows were requested, added, then removed. Aesthetic preference, not an analytics decision.</p><p>The final hierarchy carries the contrast: black bold / coral bold italic / yellow band. Full stop added. Excess white space tightened.</p><p class="small">The supplied price tiers and festival badge stayed. The client document did not receive this portfolio CTA.</p></div></div></div>
<div class="micro-edits"><article><small>GRAMMAR, NOT A NEW CONCEPT</small><div class="change"><del>Radhika had will.</del><span>→</span><b>Radhika had a will.</b></div><p>One missing article. Name and wordplay stayed.</p><img data-art="c2-07" alt="Final Radhika testimonial card"></article><article><small>HIGHLIGHT MEANING, NOT SENTENCES</small><div class="change"><span class="highlight">Long full-line runs</span><span>→</span><b>Selected benefit words</b></div><p>Speed, weight and stability became scanning anchors. Lighter pink restored readability. Importance came before colour.</p><img data-art="c2-02" alt="Final testimonial with selected benefit highlights"></article><article><small>ARCHIVED OFFER, DIFFERENT AUDIENCE</small><div class="change"><span>Client: 7 cards</span><span>→</span><b>Portfolio: 8 cards</b></div><p>C1's supplied DIY close stayed, with 12/12 changed to 8/8. C2 received the revised price close. Neither is a current shopping offer.</p><img data-art="c1-08" alt="Supplied DIY-combos portfolio CTA"></article></div></section>
<div id="final"></div><section id="carousel-1" data-carousel="1"><p class="eyebrow">06 / FINAL PAID-AD CREATIVE / CAROUSEL 1</p><h2>Show the range.</h2><p class="lead">Product education and versatility.</p><div class="final"><div><div class="ig"><div class="ig-head"><span class="avatar">cult</span><div><b>cultstore</b><small>Sponsored</small></div><i>•••</i></div><div class="ig-img"><img data-main data-art="c1-01" alt="CultStore carousel 1, slide 1 of 8"><span class="count">1/8</span></div><button class="shop" type="button" aria-label="Shop Now - mockup only">Shop Now <span>›</span></button><div class="icons" aria-hidden="true">♡ ◯ ⌁</div><div class="ig-caption"><b>cultstore</b>One bar. More ways to train at home. Move from pull-ups and chin-ups to rows and incline push-ups, then explore the add-on combinations. Swipe through the setups. Find the bar that fits your doorway.</div></div><div class="nav-slide"><button data-prev disabled>Previous</button><span data-status aria-live="polite">1 / 8</span><button data-next>Next</button></div><div class="thumbs"><button data-slide="1" aria-label="View carousel 1 slide 1" aria-current="true"><img data-art="c1-01" alt=""><span>1/8</span></button><button data-slide="2" aria-label="View carousel 1 slide 2" aria-current="false"><img data-art="c1-02" alt=""><span>2/8</span></button><button data-slide="3" aria-label="View carousel 1 slide 3" aria-current="false"><img data-art="c1-03" alt=""><span>3/8</span></button><button data-slide="4" aria-label="View carousel 1 slide 4" aria-current="false"><img data-art="c1-04" alt=""><span>4/8</span></button><button data-slide="5" aria-label="View carousel 1 slide 5" aria-current="false"><img data-art="c1-05" alt=""><span>5/8</span></button><button data-slide="6" aria-label="View carousel 1 slide 6" aria-current="false"><img data-art="c1-06" alt=""><span>6/8</span></button><button data-slide="7" aria-label="View carousel 1 slide 7" aria-current="false"><img data-art="c1-07" alt=""><span>7/8</span></button><button data-slide="8" aria-label="View carousel 1 slide 8" aria-current="false"><img data-art="c1-08" alt=""><span>8/8</span></button></div></div><div><h3>The copy decisions</h3><p>The first card turns a space objection into a product promise: "No room for a home gym?" followed by "1 bar. Endless exercises." Door-top, waist and floor positions then make the range visible. Selected add-ons extend the sequence before the DIY-combos CTA.</p><div class="notice">Instagram-style presentation, not a live ad. Caption is new presentation copy for this preview and awaits approval. Shop Now is a mockup, not checkout.</div><p class="small">Approved artwork stays in order, including archived prices and offer cards. Exercise scenes illustrate use, not the named reviewers. Prices, ratings and offers are not current shopping information.</p><a class="pdf" href="https://drive.google.com/file/d/1n6vYYgc8BI1wxz6_MfGQ3i84l8H_hEvz/view" target="_blank" rel="noopener">Open approved eight-page PDF</a></div></div></section><section id="carousel-2" data-carousel="2"><p class="eyebrow">06 / FINAL PAID-AD CREATIVE / CAROUSEL 2</p><h2>Build trust.</h2><p class="lead">Customer reviews and everyday use.</p><div class="final"><div><div class="ig"><div class="ig-head"><span class="avatar">cult</span><div><b>cultstore</b><small>Sponsored</small></div><i>•••</i></div><div class="ig-img"><img data-main data-art="c2-01" alt="CultStore carousel 2, slide 1 of 8"><span class="count">1/8</span></div><button class="shop" type="button" aria-label="Shop Now - mockup only">Shop Now <span>›</span></button><div class="icons" aria-hidden="true">♡ ◯ ⌁</div><div class="ig-caption"><b>cultstore</b>A product description tells you what a bar has. Customer reviews tell you what using it felt like. Swipe through published CultStore experiences covering setup, grip, everyday use and versatility. Choose the model that fits your space and training.</div></div><div class="nav-slide"><button data-prev disabled>Previous</button><span data-status aria-live="polite">1 / 8</span><button data-next>Next</button></div><div class="thumbs"><button data-slide="1" aria-label="View carousel 2 slide 1" aria-current="true"><img data-art="c2-01" alt=""><span>1/8</span></button><button data-slide="2" aria-label="View carousel 2 slide 2" aria-current="false"><img data-art="c2-02" alt=""><span>2/8</span></button><button data-slide="3" aria-label="View carousel 2 slide 3" aria-current="false"><img data-art="c2-03" alt=""><span>3/8</span></button><button data-slide="4" aria-label="View carousel 2 slide 4" aria-current="false"><img data-art="c2-04" alt=""><span>4/8</span></button><button data-slide="5" aria-label="View carousel 2 slide 5" aria-current="false"><img data-art="c2-05" alt=""><span>5/8</span></button><button data-slide="6" aria-label="View carousel 2 slide 6" aria-current="false"><img data-art="c2-06" alt=""><span>6/8</span></button><button data-slide="7" aria-label="View carousel 2 slide 7" aria-current="false"><img data-art="c2-07" alt=""><span>7/8</span></button><button data-slide="8" aria-label="View carousel 2 slide 8" aria-current="false"><img data-art="c2-08" alt=""><span>8/8</span></button></div></div><div><h3>The copy decisions</h3><p>The own-brand hook introduces customer evidence. Six reviews address stability, hanging, installation, removal, grip and multiple uses. Headlines are short so the review carries the argument. The portfolio CTA then presents the model choice.</p><div class="notice">Instagram-style presentation, not a live ad. Caption is new presentation copy for this preview and awaits approval. Shop Now is a mockup, not checkout.</div><p class="small">Approved artwork stays in order, including archived prices and offer cards. Exercise scenes illustrate use, not the named reviewers. Prices, ratings and offers are not current shopping information.</p><a class="pdf" href="https://drive.google.com/file/d/1mehV-gO_zBIhLXsJPV_RE3DBgTGRt-km/view" target="_blank" rel="noopener">Open approved eight-page PDF</a></div></div></section><section id="measurement"><p class="eyebrow">07 / ANALYTICS AND PROJECTIONS</p><h2>What can be estimated.<br>What cannot.</h2><div class="evidence-grid"><article><small>OBSERVED / CULTSTORE</small><h3>Creative, not returns.</h3><p>The pull-up reference was active when checked. Its details showed the creative, platforms and a 22 September 2026 start date.</p><p>No spend, impression count, CTR, purchases or ROAS was displayed. No Ads Manager report was supplied for this project.</p><a href="https://www.facebook.com/ads/library/?id=1434337641975628" target="_blank" rel="noopener">Reference checked 14 October ↗</a></article><article><small>COMPARABLE / NOT CULTSTORE</small><h3>2.01% CTR</h3><p>Sports & Outdoors median. Triple Whale: 40,000+ brands, August 2025-July 2026.</p><p>Mixed markets and formats. Not an India-only carousel result. Not a forecast for either creative.</p><a href="https://www.triplewhale.com/blog/facebook-ads-benchmarks" target="_blank" rel="noopener">Read the dataset ↗</a></article></div>
<div class="projection"><small>CONDITIONAL PROJECTION / A SCENARIO, NOT A PROMISE</small><h3>If 10,000 impressions achieved the 2.01% comparable CTR:</h3><div class="math"><span><b>10,000</b>impressions assumed</span><i>×</i><span><b>2.01%</b>external benchmark</span><i>=</i><span><b>201</b>clicks estimated</span></div><p>The same scenario applies to both routes. Assigning C2 a higher rate without a test would invent an uplift.</p><div class="sensitivity"><span><b>100 clicks</b>at an assumed 1% CTR</span><span><b>201 clicks</b>at the 2.01% benchmark</span><span><b>300 clicks</b>at an assumed 3% CTR</span></div><p class="small">The 1% and 3% values are sensitivity inputs, not sourced category benchmarks or confidence bounds. Click definition must match the source before comparison. Clicks are not landing-page visits or purchases.</p></div>
<div class="measure-two"><div><h3>Why no sales or ROAS forecast?</h3><ul><li>Spend and CPM are unknown.</li><li>India equipment data does not match the broad dataset.</li><li>Offer, page conversion and order value are unknown.</li><li>Attribution window and click definition are unconfirmed.</li></ul><p class="small">WordStream reports 1.63% Health & Fitness CTR for traffic campaigns, not purchase campaigns. India cost sources vary and often omit sampling. They were not blended into a false precise forecast.</p><a href="https://www.wordstream.com/blog/facebook-ads-benchmarks-2025" target="_blank" rel="noopener">Objective matters: WordStream ↗</a></div><div><h3>The measurement plan</h3><div class="test-row"><b>C1 hypothesis</b><span>Demonstrated range earns useful product interest.</span><small>Track outbound CTR → landing-page views → purchases.</small></div><div class="test-row"><b>C2 hypothesis</b><span>Customer evidence reduces purchase hesitation.</span><small>Track purchase rate and CPA. CTR alone cannot prove trust.</small></div><p>Hold audience, offer and destination constant. Compare actual cost and purchases. Let results choose the winner.</p><p class="small">Proposed evaluation, not a campaign that was run. No statistical or commercial outcome is claimed.</p></div></div></section></main><footer><a href="/#work">Back to My best work</a><span>CASE STUDY / CULTSTORE</span></footer>
<script src="/cultstore-art-v01-1.js"></script><script src="/cultstore-art-v01-2.js"></script><script src="/cultstore-art-v01-3.js"></script><script src="/cultstore-art-v01-4.js"></script><script src="/cultstore-art-v01-5.js"></script><script src="/cultstore-art-v01-6.js"></script><script src="/cultstore-process-v02-1.js"></script><script>document.querySelectorAll('[data-art]').forEach(i=>i.src=window.CULT_ART[i.dataset.art]);document.querySelectorAll('[data-carousel]').forEach(s=>{let i=1;function show(n){i=Math.max(1,Math.min(8,n));s.querySelector('[data-main]').src=window.CULT_ART['c'+s.dataset.carousel+'-'+String(i).padStart(2,'0')];s.querySelector('[data-main]').alt='CultStore carousel '+s.dataset.carousel+', slide '+i+' of 8';s.querySelector('.count').textContent=i+'/8';s.querySelector('[data-status]').textContent=i+' / 8';s.querySelector('[data-prev]').disabled=i===1;s.querySelector('[data-next]').disabled=i===8;s.querySelectorAll('[data-slide]').forEach(b=>b.setAttribute('aria-current',String(Number(b.dataset.slide)===i)))}s.querySelector('[data-prev]').onclick=()=>show(i-1);s.querySelector('[data-next]').onclick=()=>show(i+1);s.querySelectorAll('[data-slide]').forEach(b=>b.onclick=()=>show(Number(b.dataset.slide)))})</script></body></html>
